#include <stdio.h>
#include <string.h>

int main() 
{
    int t;
    scanf("%d", &t);

    while(t--)
    {
        char S[1000], T[1000], M[1000];
        scanf("%s %s", S, T);

        // your code goes here
          for(int k = 0; k < 5; k++)
        {   if (S[k] == T[k])
           {
               M[k]='G';
           } 
           else
           {
             M[k]='B';
            }
         }
     M[5]='\0'; 
     printf("%s\n", M);

    }

    return 0;
}