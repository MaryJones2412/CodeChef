//Solution as follows
#include <stdio.h>
#include <string.h>

int main() {
    int t;
    scanf("%d", &t);

    while (t--) {
        char A[100001], B[100001];
        scanf("%s %s", A, B);
        int n = strlen(A);
        int i = 0;
        int flag = 0;
        while (i < n) {
            if (A[i] == B[n - i - 1]) {
                i++;
            }
            else {
                flag = 1;
                break;
            }
        }

        if (flag == 1) {
            printf("No\n");
        }
        else {
            printf("Yes\n");
        }
    }
    return 0;
}